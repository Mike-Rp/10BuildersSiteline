DB_SERVER=your-session-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-reference
DB_PASSWORD=your-database-password
PGSSLMODE=no-verify
JWT_SECRET=replace-with-a-long-random-secret
API_URL=/api/v1
PORT=3000
HOST=127.0.0.1
# Opt in only AFTER approved migration 044 is installed locally.
CLIENT_OWNED_ACTIVATION=false
CLIENT_VERIFICATION_MAIL_URL=http://127.0.0.1:8026/capture
ARCHIVE_MAINTENANCE_ENABLED=false
# Dedicated backup-computer credential; never put this in VITE_* or browser code.
BACKUP_WORKER_SECRET=
