{
  "view": " SELECT DISTINCT l.user_id,\n    d.id AS discipline_id\n   FROM user_licenses l\n     JOIN ( VALUES ('Civil'::text,'Civil'::text,'Civil Engineer'::text), ('Structural'::text,'Structural'::text,'Civil Engineer'::text), ('Geotechnical'::text,'Geotechnical'::text,'Civil Engineer'::text), ('Mechanical'::text,'Mechanical'::text,'Mechanical Engineer'::text), ('Electrical'::text,'Electrical'::text,'Electrical Engineer'::text), ('Plumbing'::text,'Sanitary'::text,'Sanitary Engineer'::text), ('Interior/Finishes'::text,'Civil'::text,'Civil Engineer'::text), ('Landscape'::text,'Civil'::text,'Civil Engineer'::text)) mapping(requirement, specialization, profession) ON mapping.profession = l.profession\n     JOIN disciplines d ON d.code::text = mapping.requirement\n  WHERE l.superseded_at IS NULL AND l.verification_status = 'verified'::text AND l.verified_by IS NOT NULL AND l.verified_at IS NOT NULL AND l.revoked_at IS NULL AND NOT l.correction_required AND l.upload_status::text = 'uploaded'::text AND l.upload_file_ref IS NOT NULL AND l.license_number::text ~ '^[0-9]{7}$'::text AND l.license_expiry > ((CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Manila'::text)::date + 30) AND ((mapping.specialization = ANY (l.specializations)) OR l.specializations IS NULL AND (EXISTS ( SELECT 1\n           FROM engineer_specializations e\n          WHERE e.user_id = l.user_id AND e.specialization = mapping.specialization)));",
