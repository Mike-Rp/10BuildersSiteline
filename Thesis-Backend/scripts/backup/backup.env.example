# Copy this file to C:\siteline-backups\config\backup.env and fill it in. NEVER put the filled-in file in the repository.

# Where backups are kept. Use a folder outside the project.
BACKUP_ROOT=C:\siteline-backups

# Database connection. Copy DB_SERVER and DB_USER from Thesis-Backend\.env, but use port 5432 (not 6543).
DB_HOST=
DB_PORT=5432
DB_USER=
DB_NAME=postgres
DB_PASSWORD=

# Installed PostgreSQL command line tools (version 17 or newer).
PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe

# How many days of backups to keep.
RETENTION_DAYS=100

# Needed to copy files from Supabase Storage. Supabase dashboard > Project Settings > API (URL, and the service_role key).
# Leave both empty to back up the database only. The service_role key is very powerful: keep this file private.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reporting to the website, so the Admin Backups page shows each run and can request one.
# BACKUP_API_URL is the website's API address, for example https://10buildline.site/api/v1
# (while testing on this PC with the local backend use http://localhost:3000/api/v1).
# BACKUP_WORKER_SECRET must be exactly the same value as BACKUP_WORKER_SECRET in the backend settings.
# Leave both empty to back up without reporting.
BACKUP_API_URL=
BACKUP_WORKER_SECRET=
